resource "aws_subnet" "private_1a" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.2.0/24"
  availability_zone = "ap-south-1a"
}

# PRIVATE SUBNET - AZ b
resource "aws_subnet" "private_1b" {
  vpc_id            = aws_vpc.main.id
